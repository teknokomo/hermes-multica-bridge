# Keep the primary marker split in this source so a self-review bundle does not
# rewrite its own constant definition while escaping marker text from file bodies.
BUNDLE_FILE_BOUNDARY = "<!-- AUTOREVIEW_INTERNAL_" "FILE_BOUNDARY_V1 -->"
