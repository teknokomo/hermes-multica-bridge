    r"(?:[A-Za-z0-9]+_)*"
    r"(?:webhook_url|hmac_signing_secret|multica_pat|private_key|token|api_key|password|passwd|secret|authorization|bearer_token)"
    r"(?:_[A-Za-z0-9]+)*"
)
