TERMINAL_CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")
MULTICA_WEBHOOK_RE = re.compile(
    r"https://[^\s\"'<>]+/api/webhooks/autopilots/awt_[A-Za-z0-9_-]{20,}",
    re.IGNORECASE,
)
