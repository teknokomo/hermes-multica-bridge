    r"(?im)^(?P<prefix>[+\- ]?\s*(?:export\s+)?[\"']?)"
    r"(?P<name>"
    + SENSITIVE_ASSIGNMENT_NAME
    + r")"
    + r"(?P<key_suffix>[\"']?\s*(?P<separator>=|:)\s*)"
    + r"(?P<value>.*?)(?P<suffix>,?\s*)$"
)
SENSITIVE_MAPPING_FIELD_RE = re.compile(
    r"(?i)(?P<prefix>(?P<key_quote>['\"])(?:"
    + SENSITIVE_ASSIGNMENT_NAME
    + r")(?P=key_quote)\s*:\s*)"
