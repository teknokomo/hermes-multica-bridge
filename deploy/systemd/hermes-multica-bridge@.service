[Unit]
Description=Hermes Multica Bridge Isolated sender (%i)
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=exec
DynamicUser=yes
StateDirectory=hermes-multica-bridge-%i
StateDirectoryMode=0700
WorkingDirectory=/opt/hermes-multica-bridge
Environment=PYTHONPATH=/opt/hermes-multica-bridge
Environment=HMB_CONFIG=/etc/hermes-multica-bridge/%i.toml
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=HMB_WEBHOOK_URL:/etc/hermes-multica-bridge/credentials/%i/webhook-url
LoadCredential=HMB_HMAC_SIGNING_SECRET:/etc/hermes-multica-bridge/credentials/%i/hmac-signing-secret
LoadCredential=HMB_MULTICA_PAT:/etc/hermes-multica-bridge/credentials/%i/multica-pat
ExecStart=/usr/bin/python3 -m bridge.dispatcher --activation
StandardOutput=journal
StandardError=journal
UMask=0077
TimeoutStartSec=15s
TimeoutStopSec=1s
MemoryMax=128M
TasksMax=16
LimitNOFILE=64
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
