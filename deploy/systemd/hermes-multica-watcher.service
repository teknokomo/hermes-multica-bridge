[Unit]
Description=Hermes Multica Workspace watcher
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=exec
User=om73-watcher
Group=om73-watcher
SupplementaryGroups=hermes-multica-bridge
WorkingDirectory=/opt/hermes-multica-bridge
Environment=HMB_WATCHER_CONFIG=/etc/hermes-multica-watcher/watcher.toml
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=hermes-multica-watcher
StateDirectoryMode=0700
RuntimeDirectory=hermes-multica-watcher
RuntimeDirectoryMode=0755
LoadCredential=om73-multica-pat:/etc/hermes-multica-watcher/credentials/om73/multica-pat
LoadCredential=om73-max-token:/etc/hermes-multica-watcher/credentials/om73/max-token
LoadCredential=om73-telegram-token:/etc/hermes-multica-watcher/credentials/om73/telegram-token
ExecStart=/opt/hermes-multica-bridge/watcher-venv/bin/python -m bridge.watcher
StandardOutput=journal
StandardError=journal
UMask=0077
TimeoutStopSec=15s
MemoryMax=256M
TasksMax=32
LimitNOFILE=128
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
