[Unit]
Description=Central Hermes Multica notification service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-notify
Group=hermes-notify
StateDirectory=hermes-multica-notify
StateDirectoryMode=0700
RuntimeDirectory=hermes-multica-notify
RuntimeDirectoryMode=0700
UMask=0077
WorkingDirectory=/var/lib/hermes-multica-notify
Environment=HOME=/run/hermes-multica-notify
ExecStart=/opt/hermes-multica-notify/venv/bin/hermes-multica-notify --config /etc/hermes-multica-notify/notify.toml run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/hermes-multica-notify
# Add explicit LoadCredential entries for accounts/workspaces and hermes-wake-hmac
# in an operator-owned drop-in. Keep webhook-policy.json root-owned and readable only by this service.

[Install]
WantedBy=multi-user.target
